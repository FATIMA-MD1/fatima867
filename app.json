{
  "name": "FAMIA-MD",
  "description": "Javascript WhatsApp bot made by FATIMA",
  "logo": "https://i.ibb.co/p6PrJbBG/798316408-3323282417844570-7439630843634819579-n.jpg",
  "keywords": ["FATIMA-BOT"],
  "success_url": "/",
  "stack": "container",
  
  "env": {
    "MONGODB_URL": {
